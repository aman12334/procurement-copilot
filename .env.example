# Copy to .env.local and fill in. Server-side only – never prefix with NEXT_PUBLIC_. Never commit real keys.

# ---- Primary provider: openai | gemini | anthropic  (AI_PROVIDER is accepted as a legacy alias)
LLM_PRIMARY_PROVIDER=openai

# ---- OpenAI (paid API; there is no free OpenAI API tier)
OPENAI_API_KEY=
# Exact model id available to your key – list them with `npm run llm:models`. Required; never chosen automatically.
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_OUTPUT_TOKENS=32000
# Reasoning models only: none | minimal | low | medium | high
OPENAI_REASONING_EFFORT=

# ---- Fallback (only to a verified FREE provider; every switch is recorded)
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=free
# Only "gemini" (Google AI Studio free tier) is accepted. Leave empty to disable fallback.
FREE_PROVIDER=
FREE_MODEL=
# Total attempts per call for 429 rate limits / 5xx (bounded exponential backoff). Quota exhaustion is never retried.
LLM_MAX_RETRIES=3
LLM_FALLBACK_ON_QUOTA=true
LLM_FALLBACK_ON_RATE_LIMIT=true
LLM_FALLBACK_ON_PROVIDER_UNAVAILABLE=true

# ---- Gemini (free-tier fallback or primary). Model is pinned: no default.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT_MS=

# ---- Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=

# ---- Optional evaluation overrides (defaults come from the RFx: 88.50 INR/USD, 5% freight loading)
EVAL_USD_INR=
EVAL_FREIGHT_LOADING_PCT=

# Optional: "debug" logs raw model responses
RFX_LOG_LEVEL=info
# RFx generation: parallel (default, ~4 concurrent smaller calls) | single (one call; the frozen eval path)
RFX_GENERATION_MODE=parallel
